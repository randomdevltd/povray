// stills: authored from tools/language/reference/SKILL.md and reference.mjs lookups only
// (let, fn, for, rgb, sphere, plane, torus, pigment, finish, light_source, camera)
global_settings { assumed_gamma 1.0 }
camera { location <0, 1.6, -4.5> look_at <0, 0.9, 0> }
light_source { <4, 6, -3> rgb 1 }
let Floor = plane { y, -1
  pigment { checker color rgb <0.8, 0.8, 0.8> color rgb <0.25, 0.3, 0.4> }
  finish { phong 0.2 }
};
Floor
fn Glossy(Centre, Radius, Tint, P) {
  sphere { Centre, Radius
    pigment { color Tint }
    finish { phong P phong_size 40 }
  }
}
Glossy(<-1.1, 1, 0>, 1, rgb <0.9, 0.3, 0.2>, 0.7)
Glossy(<1.1, 1, 0>, 1, rgb <0.2, 0.5, 0.9>, 0.7)
for (I = 0 to 2) {
  Glossy(<I * 0.9 - 0.9, 0.25, 1.4>, 0.25, rgb <0.9, 0.9, 0.9>, 0.5)
}
let Ring = torus { 0.55, 0.18
  translate <0, 1.8, 0>
  pigment { color rgb <0.95, 0.8, 0.2> }
  finish { phong 0.9 phong_size 60 }
};
Ring

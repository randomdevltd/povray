// light_group global_lights in the 4.0 language: two white panels, each in its own light_group with its own
// interior (volume) light, red on the left and green on the right, and one blue light_source outside both groups.
// Each emitter sits above the panels and in front of them, so it could light both panels if the groups let it.
// Global is global_lights' value in both groups: 1 (on) or 0 (off).
input Global = 1;
global_settings { assumed_gamma 1 ambient_light 0 }
camera { orthographic location <0, 0, -10> look_at <0, 0, 0> right x * 6 up y * 2 }
background { rgb 0 }
light_source { <0, 0, -20> rgb <0, 0, 0.5> }
light_group {
  box { <-2.5, -1, 0>, <-0.5, 1, 0.2> pigment { rgb 1 } finish { ambient 0 diffuse 1 } }
  sphere { <-1.5, 2, -1.5>, 0.5 pigment { rgbt 1 } hollow
    interior { light { pigment { rgb <1, 0, 0> } brightness 20 samples 16 } } }
  global_lights Global
}
light_group {
  box { <0.5, -1, 0>, <2.5, 1, 0.2> pigment { rgb 1 } finish { ambient 0 diffuse 1 } }
  sphere { <1.5, 2, -1.5>, 0.5 pigment { rgbt 1 } hollow
    interior { light { pigment { rgb <0, 1, 0> } brightness 20 samples 16 } } }
  global_lights Global
}

include "scene.inc";
fn Ret(A, B) { return A > B; }
fn Last(A, B) { A > B }
fn Paren(A, B) { (A > B); }
let A = 3;
let B = 2;
let H = -30;
let Less = A < B;
let Got = [Ret(A, B), Last(A, B), A > B, 2 > 1, A == B, A && B, A > 1 ? 5 : 6, (A < B) || (B < A),
  Less, !A || B >= 2, (H < 0 ? H + 360 : H), ((L) => L <= 0)(H)];
let Want = [Paren(A, B), (A > B), (A > B), (2 > 1), (A == B), (A && B), (A > 1) ? 5 : 6, ((A < B) || (B < A)),
  (A < B), ((!A) || (B >= 2)), 330, 1];
for (I = 0 to 11) { if (Got[I] != Want[I]) { error(concat("bare comparison ", str(I, 0, 0), " differs")); } }
debug("pov4 bare comparisons\n");
sphere { 0, 1 scale A > B ? 1 : 2 pigment { rgb 1 } }

// A media light: the sphere's own RGB emission field shapes and colours the light it casts on the floor, scaled to 40 lumens. +w400 +h300
global_settings { assumed_gamma 1 }
camera { location <0, 3, -6> look_at <0, 0.7, 0> right x * image_width / image_height angle 40 }
plane { y, 0 pigment { rgb 0.7 } finish { ambient 0.1 diffuse 0.8 } } // the 3.7 default ambient, as the classic twin gets
sphere {
  0, 0.5
  pigment { rgbt 1 } hollow
  interior {
    media { method 4 emission rgb <10, 4, 1> density { spherical scale 0.5 } }
    light { emission brightness 40 lumens samples 64 }
  }
  translate y
}

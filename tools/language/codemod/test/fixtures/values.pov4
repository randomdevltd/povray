let On = ((Grid[0][1] == 2) && !(Props.size == 1));
camera { location <0, 1, -5> look_at 0 }
light_source { <10, 10, -10>, White }
plane { y, 0 pigment { color rgb <0.5, 0.5, 0.5> } }
let Padded = [ 1, 2, null, null ];
let Key = "name";
let Mixed = { [Key]: 1, "step": 2, "x": 3 };
let Steps = Mixed["step"] + Mixed["step"];
Padded = null;
let Spaced = { [Key]: 1, a: 2 };
let Rows = [ array(3), array(3) ];
let Sized = [ 1, ...array((Count + 1) - 1) ];

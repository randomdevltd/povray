include "scene.inc";
let N = 12;
let Ring = [for (I = 0 to N - 1) { <cos(I * tau / N), 0, sin(I * tau / N)> }];
mesh2 {
  vertex_vectors { len(Ring) + 1, ...Ring, <0, 1, 0> }
  face_indices { N, ...[for (I = 0 to N - 1) { <I, mod(I + 1, N), N> }] }
  pigment { rgb <0.2, 0.6, 0.9> }
  translate <0, 0, 2>
}
let Path = map(range(0, 6), (I) => <I - 3, 0.5 + 0.3 * sin(I), -1.5>);
sphere_sweep {
  linear_spline len(Path),
  ...[for (P in Path) { P, 0.15 }]
  pigment { rgb <0.9, 0.5, 0.1> }
}

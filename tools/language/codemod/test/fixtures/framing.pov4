// framing: look_at an object identifier or a tagged selection
let Subject = union {
  sphere { -x, 0.5 }
  box { <0.6, -0.4, -0.4>, <1.4, 0.4, 0.4> }
  translate <2, 0.5, 3>
  tags { "subject" }
};
object { Subject }
let Wide = camera { location <0, 1.6, -4.5> look_at tagged { "subject" & !"draft" }, 0.8 };
camera { location <0, 1.6, -4.5> look_at Subject }
let Copy = tagged { "subject" };
object { tagged { "subject" } translate x * 3 }

input Case = 0;
input Samples = 32;
input Units = 0;
input Alias = 0;
input Bounce = 0;
input Passive = 0;
global_settings { assumed_gamma 1 }
camera { orthographic location <0,5,-1> look_at 0 right x*2 up z*2 }
background { rgb 0 }
plane { y,0 pigment { rgb 1 } finish { ambient 0 diffuse 1 } }
let Source = pigment { rgb 1 };
let Shape = sphere { <0,1.5,0>,0.25 };
if (Case == 1) { Shape = box { <-0.7,1.4,-0.04>, <0.7,2.1,0.04> }; }
if (Case == 2) { Shape = box { <-0.8,1.5,-0.03>, <0.8,1.55,0.03> }; }
if (Case == 3) {
  Shape = difference {
    sphere { 0,0.35 }
    box { <-0.1,-0.5,-0.5>, <0.5,0.5,0.5> }
    translate y*1.5
  };
}
if (Case == 4) {
  Shape = mesh {
    triangle { <-0.5,1.5,-0.5>, <0.5,1.5,0.5>, <0.5,1.5,-0.5> }
    triangle { <-0.5,1.5,-0.5>, <-0.5,1.5,0.5>, <0.5,1.5,0.5> }
  };
}
if (Case == 5) { Source = pigment { rgb <0.8,0.4,0.2> }; }
if (Case == 6) {
  Shape = sphere { 0,1 scale <0.15,0.35,0.25> rotate z*20 translate y*1.5 };
}
if (Case == 7) {
  Shape = union {
    sphere { <-0.2,1.5,0>,0.25 }
    sphere { <0.2,1.5,0>,0.25 }
  };
}
object { Shape no_image
  pigment { rgb <0.4,0.2,0.1> }
  finish { ambient 0 if (Passive) { emission 0 } else { emission 2 } diffuse 0 }
  light {
    if (Alias) { emission } else { if (Case == 5) { pigment { Source } } }
    if (Units == 1) { brightness (8*4*pi*pi*0.25*0.25) lumens }
    else { brightness 8 if (Units != 2) { nits } }
    samples Samples
    if (Bounce == 1) { bounce }
    if (Bounce == 2) { bounce { passes 1 } }
    if (Bounce > 2) { bounce { passes 3 } }
  }
}

if (Bounce == 4) {
  sphere { <0.8,1.5,0>,0.2 no_image
    pigment { rgb <0.2,0.5,1> }
    finish { ambient 0 emission 1 diffuse 0.5 }
    light { bounce { passes 1 } samples Samples }
  }
}

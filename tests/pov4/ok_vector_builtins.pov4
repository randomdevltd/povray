include "scene.inc";
fn Place(P) { return vnormalize(P) * 2; }
let Box = box { -1, 1 };
let N = vnormalize(vcross(x, y));
let R = vrotate(vcross(x, z), vrotate(y, 0));
let A = vaxis_rotate(vnormalize(x + y), vcross(z, x), 30);
let T = vturbulence(2, 0.5, 6, vnormalize(<1, 2, 3>));
let E = vnormalize(max_extent(Box) - min_extent(Box));
let H = vnormalize(trace(Box, <0, 0, -5>, z));
let S = vnormalize(1) * 0.2 + vrotate(N, 90) * 0.5;
let L = vlength(2) * vdot(1, N) * 0.1;
for (P in [N, R, A, T, E, H, S, S + L]) { sphere { Place(P), 0.3 pigment { rgb 1 } } }

// framing: look_at an object value frames its bounds, here at 0.8 of the image
global_settings { assumed_gamma 1.0 }
light_source { <4, 6, -3> rgb 1 }
plane { y, -1.5 pigment { checker color rgb 0.8 color rgb <0.25, 0.3, 0.4> } }
fn Pair(Gap) {
  box { -1, <0, 1, 1> pigment { color rgb <0.2, 0.5, 0.9> } }
  sphere { x * Gap, 1 - Gap pigment { color rgb <0.9, 0.3, 0.2> } }
}
let Subject = union { Pair(0.5) };
Subject
camera { location <0, 0, -10> right x * 4 / 3 up y look_at Subject, 0.8 }

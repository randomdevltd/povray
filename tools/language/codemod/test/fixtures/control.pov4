  sphere { <I, 0, 0>, 0.4 }
  I = I + 1;
}

union {
  for (J = 0 to 1 step 0.25) {
    box { <J, 0, 0>, <J + 0.2, 1, 1> }
  }
  translate y * ((Q > 1) ? 2 : 1)
}


global_settings { assumed_gamma 1 }
camera { orthographic location <0,5,-1> look_at 0 right x*2 up z*2 }
plane { y,0 pigment { rgb 1 } finish { ambient 0 diffuse 1 } }
box { -1,1 pigment { rgbt 1 } hollow no_image
  interior {
    media { method 4 mix add emission rgb 100 }
    media { method 4 mix replace emission rgb <10,4,2> absorption rgb 0 }
    media { method 4 mix add emission rgb <2,1,0.5> }
    media { method 4 mix multiply density { rgb 0.5 } }
    media { method 4 mix subtract emission rgb <1,0.5,0.25> }
    light { emission brightness 0.2 nits samples 16 }
  }
  scale <0.35,0.25,0.3> rotate y*15 translate y*1.5
}

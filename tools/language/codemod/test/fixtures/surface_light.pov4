global_settings { assumed_gamma 1 }
box { <-1,1,-1>, <1,1.1,1> pigment { rgb <1,0.5,0.2> } finish { emission 2 } light { emission brightness 12 lumens samples 8 media_attenuation on bounce { passes 3 } } }
sphere { <0,2,0>, 0.2 light { pigment { rgb <0.2,0.5,1> } brightness 3 nits samples 4 bounce } }

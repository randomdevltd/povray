// The 4.0 form of csg_child_tree.pov's large CSGs: every image must match the linear scan's (POV_CSG_CHILD_TREE=0).
// A union kept whole by its light, an intersection-wrapped union, a merge, a difference with many cutters,
// a plane clipped_by a union and children each clipped_by.
input N = 6;
global_settings { assumed_gamma 1 max_trace_level 8 }
camera { location <13, 20, -34> look_at <13, 0, 4> angle 46 }
light_source { <-30, 60, -40> rgb 1 }
background { rgb 0.15 }
let R = seed(7);
fn Grid(Size) {
  for (I = 0 to N - 1) { for (J = 0 to N - 1) { for (K = 0 to N - 1) {
    let P = <I, J, K> * 6 / N + <rand(R), rand(R), rand(R)> * 0.3;
    if (mod(I + J + K, 3) == 0) { box { P - Size, P + Size } } else { sphere { P, Size * 1.2 } }
  } } }
}
union {
  ...Grid(0.22)
  light_source { <3, 7, 3> rgb 0.3 }
  pigment { rgb <0.85, 0.7, 0.5> }
  translate <0, 0, 8>
}
intersection {
  union { ...Grid(0.25) }
  box { <-1, -1, -1>, <7, 4.1, 7> }
  pigment { rgb <0.5, 0.75, 0.9> }
  translate <9, 0, 8>
}
merge {
  for (I = 0 to N * N * 3) { sphere { <rand(R), rand(R), rand(R)> * 5, 0.5 + rand(R) * 0.4 } }
  pigment { rgbf <0.8, 0.95, 0.85, 0.7> }
  interior { ior 1.3 }
  translate <0, 0, -2>
}
difference {
  box { <0, 0, 0>, <6, 4, 6> }
  for (I = 0 to N * N * 3) { sphere { <rand(R) * 6, 4 + (rand(R) - 0.5) * 1.2, rand(R) * 6>, 0.25 + rand(R) * 0.3 } }
  sphere { <0, 4, 0>, 1.5 clipped_by { box { <-2, 3, -2>, <0.5, 5, 0.5> } } }
  pigment { rgb <0.9, 0.55, 0.4> }
  translate <9, 0, -2>
}
plane { <0.2, 1, -0.3>, 2
  clipped_by { union { ...Grid(0.3) } }
  pigment { rgb <0.95, 0.9, 0.3> }
  translate <0, 0, -12>
}
union {
  for (I = 0 to N * N * 2) {
    let P = <rand(R) * 6, rand(R) * 4, rand(R) * 6>;
    sphere { P, 0.5 clipped_by { box { P - <0.6, 0.6, 0.6>, P + <0.6, 0.15, 0.6> } } }
  }
  pigment { rgb <0.6, 0.5, 0.9> }
  translate <9, 0, -12>
}
plane { y, -0.01 pigment { rgb 0.5 } }
